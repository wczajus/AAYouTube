<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Navigation category: a full-screen map surface the page is drawn on (CarBrowser). -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:name=".AAYouTubeApp"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AAYouTube">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android Auto projection screen (legacy Android Auto SDK, as used by Fermata Auto). -->
        <service
            android:name=".car.YouTubeProjectionService"
            android:exported="true"
            android:icon="@drawable/ic_app"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

        <!-- Video screen as an Android Auto navigation app (Car App Library). The desktop head unit
             always lists it; real cars only once the Play Store is recorded as the installer
             (install/PlayStoreInstall.kt). -->
        <service
            android:name=".car.YouTubeCarAppService"
            android:exported="true"
            android:icon="@drawable/ic_app"
            android:label="@string/nav_service_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Android Auto media entry. Its label must differ from the projection screen's: Fermata does
             the same ("Fermata Media Service"), otherwise Android Auto may show only one of the two. -->
        <service
            android:name=".media.YouTubeMediaService"
            android:exported="true"
            android:icon="@drawable/ic_app"
            android:label="@string/media_service_name">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Hands the picked APK to the system installer (install/PlayStoreInstall.kt). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
