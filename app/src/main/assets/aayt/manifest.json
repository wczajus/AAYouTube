{
  "manifest_version": 2,
  "name": "AAYouTube page tweaks",
  "version": "1.1",
  "description": "Changes to the YouTube page for the car screen. Bump the version when changing it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aayt@czajus.pl"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "fullscreen.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
